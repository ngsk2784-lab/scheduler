# Supabase 프로젝트 설정 (필수)
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) 한국 공공데이터 개방 API 키 - holidays-kr 용
# https://www.data.go.kr 에서 "국가법정공휴일 정보" 키 신청 후 입력
NEXT_PUBLIC_HOLIDAYS_API_KEY=

# (선택) 알림 웹훅 (디스코드/슬랙) - 통계>알림 보내기, 자동 발송
# 디스코드: https://discord.com/api/webhooks/...
# 슬랙:     https://hooks.slack.com/services/...
WEBHOOK_URL=

# (선택) 매일 아침 8시(KST) 자동 알림 - "on" 으로 설정 시 활성화
AUTO_NOTIFY_ON=

# (선택) 관리자 잠금 PIN - 설정하면 등록/수정 전 PIN 필요 (헤더 자물쇠)
NEXT_PUBLIC_ADMIN_PIN=
